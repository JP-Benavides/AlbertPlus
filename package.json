{
  "name": "nyu-scraper",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "check:types": "tsc --noEmit",
    "db:studio:local": "drizzle-kit studio --config=drizzle-dev.config.ts",
    "db:studio:remote": "drizzle-kit studio --config=drizzle-prod.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle-dev.config.ts",
    "db:push:dev": "drizzle-kit push --config=drizzle-dev.config.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle-prod.config.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "bun test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "biome check"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.4",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@libsql/client": "^0.15.15",
    "@types/bun": "1.3.4",
    "@types/node": "^24.10.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.54.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.0",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.9",
    "zod": "^4.1.13"
  }
}
